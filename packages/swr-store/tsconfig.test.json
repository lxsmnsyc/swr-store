{
  "extends": "./tsconfig.json",
  "include": ["src", "test", "types"],
  "exclude": ["node_modules", "src/solid", "test/solid"],
  "compilerOptions": {
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    // `preact/compat` declares a global `React` namespace that clashes with
    // `@types/react` once both bindings load in one program.
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["node"]
  }
}
